<?xml version="1.0"?>
<!--
    POSPac Batch File: re112o_250610 (EXTRACT ONLY)

    Purpose:
    Extract APX data and identify actual camera trigger events.

    Description:
    After running this batch file, parse the output file 
    "extract_Mission 1.log" to determine the time window during which 
    the drone was actively scanning the target.

    This time window is required to define accurate start and stop times 
    for the subsequent batch file, which performs full processing and 
    exports position data.

    Note:
    Trimming unused data is important, as excess data or gaps may lead 
    to processing issues in the final solution.
-->
<Batch xmlns:xsd="http://www.w3.org/2001/XMLSchema"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <Project>
        <n>re112o_250610</n>

        <Extract>
            <FirstPosFile>E:\mjolnir_processing\re112o_250610\RAW\apx\6234C84164202506100820.T04</FirstPosFile>
            <LastPosFile>E:\mjolnir_processing\re112o_250610\RAW\apx\6234C84164202506100858.T04</LastPosFile>
            <ScanImuForDataGaps>true</ScanImuForDataGaps>
        </Extract>

    </Project>

    <Version>4.0</Version>

</Batch>
